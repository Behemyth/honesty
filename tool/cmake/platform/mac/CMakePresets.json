{
	"version": 9,
	"include": [
		"../common/CMakePresets.json"
	],
	"configurePresets": [
		{
			"name": "macos-default",
			"inherits": [
				"default"
			],
			"hidden": true,
			"description": "Base preset for macOS configurations",
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Darwin"
			},
			"cacheVariables": {
				"CMAKE_C_FLAGS_INIT": "-Wall -Wextra -Wpedantic",
				"CMAKE_CXX_FLAGS_INIT": "-Wall -Wextra -Wpedantic"
			}
		},
		{
			"name": "macos-ninja-clang",
			"displayName": "Ninja Clang",
			"description": "Ninja Multi-Config generator with Apple Clang",
			"generator": "Ninja Multi-Config",
			"inherits": [
				"macos-default"
			]
		},
		{
			"name": "macos-ninja-clang-release",
			"inherits": [
				"cppython-release",
				"macos-ninja-clang"
			],
			"binaryDir": "${sourceDir}/build/${presetName}",
			"cacheVariables": {
				"CMAKE_CONFIGURATION_TYPES": {
					"type": "STRING",
					"value": "Release"
				}
			}
		},
		{
			"name": "macos-ninja-clang-development",
			"inherits": [
				"cppython-debug",
				"macos-ninja-clang"
			],
			"binaryDir": "${sourceDir}/build/${presetName}",
			"cacheVariables": {
				"CMAKE_CONFIGURATION_TYPES": {
					"type": "STRING",
					"value": "Development"
				},
				"CMAKE_MAP_IMPORTED_CONFIG_DEVELOPMENT": {
					"type": "STRING",
					"value": "Debug"
				}
			}
		},
		{
			"name": "macos-ninja-clang-debug",
			"inherits": [
				"cppython-debug",
				"macos-ninja-clang"
			],
			"binaryDir": "${sourceDir}/build/${presetName}",
			"cacheVariables": {
				"CMAKE_CONFIGURATION_TYPES": {
					"type": "STRING",
					"value": "Debug"
				}
			}
		}
	],
	"buildPresets": [
		{
			"name": "macos-default",
			"hidden": true,
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Darwin"
			}
		},
		{
			"name": "macos-ninja-clang-release",
			"displayName": "Ninja Clang Release",
			"configurePreset": "macos-ninja-clang-release",
			"configuration": "Release",
			"inherits": [
				"macos-default"
			]
		},
		{
			"name": "macos-ninja-clang-development",
			"displayName": "Ninja Clang Development",
			"configurePreset": "macos-ninja-clang-development",
			"configuration": "Development",
			"inherits": [
				"macos-default"
			]
		},
		{
			"name": "macos-ninja-clang-debug",
			"displayName": "Ninja Clang Debug",
			"configurePreset": "macos-ninja-clang-debug",
			"configuration": "Debug",
			"inherits": [
				"macos-default"
			]
		}
	],
	"testPresets": [
		{
			"name": "macos-default",
			"hidden": true,
			"output": {
				"outputOnFailure": true,
				"shortProgress": true
			},
			"inherits": [
				"default"
			]
		},
		{
			"name": "macos-ninja-clang-debug",
			"displayName": "Ninja Clang Debug",
			"configurePreset": "macos-ninja-clang-debug",
			"inherits": [
				"macos-default"
			],
			"configuration": "Debug"
		},
		{
			"name": "macos-ninja-clang-development",
			"displayName": "Ninja Clang Development",
			"configurePreset": "macos-ninja-clang-development",
			"inherits": [
				"macos-default"
			],
			"configuration": "Development"
		},
		{
			"name": "macos-ninja-clang-release",
			"displayName": "Ninja Clang Release",
			"configurePreset": "macos-ninja-clang-release",
			"inherits": [
				"macos-default"
			],
			"configuration": "Release"
		}
	]
}
