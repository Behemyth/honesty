{
	"version": 9,
	"include": [
		"../common/CMakePresets.json"
	],
	"configurePresets": [
		{
			"name": "linux-default",
			"inherits": [
				"default"
			],
			"hidden": true,
			"description": "Base preset for Linux configurations",
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Linux"
			},
			"cacheVariables": {
				"CMAKE_C_FLAGS_INIT": "-Wall -Wextra -Wpedantic",
				"CMAKE_CXX_FLAGS_INIT": "-Wall -Wextra -Wpedantic"
			}
		},
		{
			"name": "linux-ninja-gcc",
			"displayName": "Ninja GCC",
			"description": "Ninja Multi-Config generator with GCC",
			"generator": "Ninja Multi-Config",
			"inherits": [
				"linux-default"
			],
			"cacheVariables": {
				"CMAKE_C_COMPILER": "gcc",
				"CMAKE_CXX_COMPILER": "g++"
			}
		},
		{
			"name": "linux-ninja-gcc-release",
			"inherits": [
				"cppython-release",
				"linux-ninja-gcc"
			],
			"binaryDir": "${sourceDir}/build/${presetName}",
			"cacheVariables": {
				"CMAKE_CONFIGURATION_TYPES": {
					"type": "STRING",
					"value": "Release"
				}
			}
		},
		{
			"name": "linux-ninja-gcc-development",
			"inherits": [
				"cppython-debug",
				"linux-ninja-gcc"
			],
			"binaryDir": "${sourceDir}/build/${presetName}",
			"cacheVariables": {
				"CMAKE_CONFIGURATION_TYPES": {
					"type": "STRING",
					"value": "Development"
				},
				"CMAKE_MAP_IMPORTED_CONFIG_DEVELOPMENT": {
					"type": "STRING",
					"value": "Debug"
				}
			}
		},
		{
			"name": "linux-ninja-gcc-debug",
			"inherits": [
				"cppython-debug",
				"linux-ninja-gcc"
			],
			"binaryDir": "${sourceDir}/build/${presetName}",
			"cacheVariables": {
				"CMAKE_CONFIGURATION_TYPES": {
					"type": "STRING",
					"value": "Debug"
				}
			}
		}
	],
	"buildPresets": [
		{
			"name": "linux-default",
			"hidden": true,
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Linux"
			}
		},
		{
			"name": "linux-ninja-gcc-release",
			"displayName": "Ninja GCC Release",
			"configurePreset": "linux-ninja-gcc-release",
			"configuration": "Release",
			"inherits": [
				"linux-default"
			]
		},
		{
			"name": "linux-ninja-gcc-development",
			"displayName": "Ninja GCC Development",
			"configurePreset": "linux-ninja-gcc-development",
			"configuration": "Development",
			"inherits": [
				"linux-default"
			]
		},
		{
			"name": "linux-ninja-gcc-debug",
			"displayName": "Ninja GCC Debug",
			"configurePreset": "linux-ninja-gcc-debug",
			"configuration": "Debug",
			"inherits": [
				"linux-default"
			]
		}
	],
	"testPresets": [
		{
			"name": "linux-default",
			"hidden": true,
			"output": {
				"outputOnFailure": true,
				"shortProgress": true
			},
			"inherits": [
				"default"
			]
		},
		{
			"name": "linux-ninja-gcc-debug",
			"displayName": "Ninja GCC Debug",
			"configurePreset": "linux-ninja-gcc-debug",
			"inherits": [
				"linux-default"
			],
			"configuration": "Debug"
		},
		{
			"name": "linux-ninja-gcc-development",
			"displayName": "Ninja GCC Development",
			"configurePreset": "linux-ninja-gcc-development",
			"inherits": [
				"linux-default"
			],
			"configuration": "Development"
		},
		{
			"name": "linux-ninja-gcc-release",
			"displayName": "Ninja GCC Release",
			"configurePreset": "linux-ninja-gcc-release",
			"inherits": [
				"linux-default"
			],
			"configuration": "Release"
		}
	]
}
